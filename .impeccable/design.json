      "html": "<button class=\"ds-btn ds-btn-primary\">Add a project</button>",
      "css": ".ds-btn{font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:.84375rem;font-weight:600;letter-spacing:-.005em;line-height:1.2;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;padding:7px 16px;border:0;border-radius:999px;cursor:pointer;transition:background 150ms,transform 150ms cubic-bezier(.22,1,.36,1)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid #c46f00;outline-offset:2px}.ds-btn-primary{background:#232323;color:#fff}@media (hover:hover) and (pointer:fine){.ds-btn-primary:hover{background:#000}}"
